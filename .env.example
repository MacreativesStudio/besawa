# ==============================================================================
# BE SAWA V1 — PRODUCTION ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================
# Copy this file to .env for local runtime or inject these keys into your
# production Cloud Run / PaaS environment variables dashboard.
# NEVER commit the active .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# APP_URL: The base URL of the deployed application.
# Used for server-to-server callbacks, M-Pesa webhooks, and absolute notification URLs.
# Scope: Server-side only
# Required: YES in production
APP_URL="https://besawa.ke"

# PORT: The port the Node/Express backend process listens on.
# Scope: Server-side
# Required: YES (Default: 3000)
PORT=3000

# NODE_ENV: Application environment mode ('development' or 'production').
# Scope: Server-side
# Required: YES
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection pooler URI (e.g. Supabase, AWS RDS, Cloud SQL).
# Format: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
# Fallback: When blank, the system automatically uses the ACID JSON engine in data/be_sawa_db.json.
# Scope: Server-side only
# Required: Optional in prototype / Mandatory for high-concurrency multi-instance production
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: High-entropy cryptographic string used to sign session tokens for
# Business Owner (Muthoni Maina), Platform Admin (Stephen), and Practitioners.
# Generate via: openssl rand -base64 48
# Scope: Server-side only (CONFIDENTIAL)
# Required: YES
JWT_SECRET="GENERATE_A_UNIQUE_64_PLUS_CHARACTER_SECRET_FOR_EACH_ENVIRONMENT"

# ADMIN_INITIAL_PASSWORD: Seed password for initial system provisioning.
# Scope: Server-side only
ADMIN_INITIAL_PASSWORD="SET_A_UNIQUE_INITIAL_PASSWORD_OUTSIDE_SOURCE_CONTROL"

# TECHNICAL_ADMIN_PASSWORD: Seed password for technical administrator account.
# Scope: Server-side only
TECHNICAL_ADMIN_PASSWORD="SET_A_UNIQUE_INITIAL_PASSWORD_OUTSIDE_SOURCE_CONTROL"

# Comma-separated server-side allowlists for privileged identities. In production,
# a business or technical administrator must have both the correct role and an
# email in the matching allowlist. Do not add these values to frontend variables.
ADMIN_ALLOWED_EMAILS=""
TECH_ALLOWED_EMAILS=""

# ------------------------------------------------------------------------------
# 4. SAFARICOM M-PESA DARAJA PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
# MPESA_ENVIRONMENT: 'sandbox' for developer testbed, 'live' for production transactions.
# Scope: Server-side only
# Required: YES
MPESA_ENVIRONMENT="sandbox"

# MPESA_CONSUMER_KEY: Daraja API App Consumer Key from Safaricom Developer Portal.
# Scope: Server-side only
# Required: YES for live STK Push
MPESA_CONSUMER_KEY=""

# MPESA_CONSUMER_SECRET: Daraja API App Consumer Secret.
# Scope: Server-side only (CONFIDENTIAL)
# Required: YES for live STK Push
MPESA_CONSUMER_SECRET=""

# MPESA_PASSKEY: Lipa Na M-Pesa Online (LNM) Passkey.
# Used to calculate the base64 encrypted password payload: base64(Shortcode + Passkey + Timestamp).
# Scope: Server-side only (CONFIDENTIAL)
# Required: YES for live STK Push
MPESA_PASSKEY=""

# MPESA_SHORTCODE: Business Till Number or Paybill Number (e.g. 174379 in Sandbox).
# Scope: Server-side only
# Required: YES
MPESA_SHORTCODE="174379"

# MPESA_CALLBACK_URL: Public HTTPS webhook route Safaricom will ping upon payment result.
# Format: https://besawa.ke/api/payments/mpesa/callback
# Scope: Server-side only
# Required: YES in production
MPESA_CALLBACK_URL="https://besawa.ke/api/payments/mpesa/callback"

# ------------------------------------------------------------------------------
# 5. WHATSAPP & BUSINESS CARE DESK
# ------------------------------------------------------------------------------
# CARE_WHATSAPP_NUMBER: Primary WhatsApp care desk number in international format.
# Scope: Client & Server
CARE_WHATSAPP_NUMBER="254710759422"

# PRACTICE_DESK_NUMBER: Secondary practice desk number.
# Scope: Client & Server
PRACTICE_DESK_NUMBER="254745024278"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & APPOINTMENT NOTIFICATIONS
# ------------------------------------------------------------------------------
# SMTP parameters for booking confirmation emails sent to clients and admin.
# Scope: Server-side only
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFICATION_FROM_EMAIL="care@besawa.ke"
